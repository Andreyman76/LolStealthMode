<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LolStealthMode.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LolStealthMode.Views.MainView"
             x:DataType="vm:MainViewModel"
             >

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

    <UserControl.Background>
		<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
			<GradientStop Color="#0B1F33" Offset="0"/>
			<GradientStop Color="#007992" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

  <UserControl.Styles>

    <Style Selector="Border#Circle">
      <Setter Property="RenderTransform" Value="scale(1)"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>

    <!-- Hover -->
    <Style Selector="Border#Circle:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.08)"/>
      <Setter Property="Opacity" Value="0.96"/>
    </Style>

  </UserControl.Styles>

  <Grid>
    <Border x:Name="Circle"
            Width="200" Height="200"
            CornerRadius="100"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            PointerPressed="OnClick"
            BorderBrush="#E6B84C"
            BorderThickness="4"
            BoxShadow="inset 0 10 50 10 #80000000">

      <!-- Градиент -->
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#123A5A" Offset="0"/>
          <GradientStop Color="#0E2C47" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>

      <Grid>
        <TextBlock x:Name="Label"
                   Text="Enable"
                   Foreground="#E6B84C"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
      </Grid>

    </Border>
  </Grid>
</UserControl>